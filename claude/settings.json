{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Fetch(*)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__save_project"
    ],
    "deny": [
      "Bash(gt *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "address-reviewer-feedback": "off",
    "link-stack-to-linear": "off",
    "monitor-pr": "off",
    "new-pr": "off",
    "new-worktree": "off",
    "repair-ci-failures": "off",
    "resolve-merge-conflicts": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "$HOME/.claude/hooks/review-changed-code", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "$HOME/.claude/hooks/review-changed-code", "timeout": 5}]}
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-status",
    "padding": 0
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "defaultMode": "acceptEdits"
}
