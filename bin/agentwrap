#!/usr/bin/env bash
# usage: <SCRIPT> status
#        <SCRIPT> [-p NAME] edit
#        <SCRIPT> [-p NAME] save [--force]
#        <SCRIPT> [-p NAME] run [COMMAND [ARGS...]]
#
# Commands:
#   status      Show which profile is currently being edited
#   edit        Edit the profile in the current repo
#   save        Save the current repo's changes as a profile
#   run         Run COMMAND (default: $SHELL) with the profile's patch applied
#
# Options:
#   -p|--profile NAME   which profile to use (default: repo dirname up to "-")
#   --force             save over an existing profile even if 'edit' wasn't used
#
# Profiles are stored in ~/.config/agentwrap/<NAME>.patch.
#
# Known issues:
#   - Codex needs allow_login_shell=false in ~/.codex/config.toml to prevent it
#     bypassing the git/jj wrappers.
#

script_basename=$(basename "$0")

usage() {
  awk <"$0" -v script="$script_basename" '/$^/{exit}; NR==2,0{gsub(/<SCRIPT>/, script); print substr($0, 3)}'
}

log() {
  printf >&2 '%s: %s\n' "$script_basename" "$*"
}

profile=
force=
mode=
run_args=()
while (( $# > 0 )); do
  case "$1" in
    --help)
      usage
      exit
      ;;
    -p|--profile)
      if (( $# < 2 )); then
        usage >&2
        exit 2
      fi
      profile=$2
      shift 2
      ;;
    --force)
      force=yes
      shift
      ;;
    status|edit|save|run)
      if [[ $mode ]]; then
        usage >&2
        exit 2
      fi
      mode=$1
      shift
      ;;
    *)
      if [[ $mode == run ]]; then
        run_args+=("$@")
        shift $#
      else
        usage >&2
        exit 2
      fi
      ;;
  esac
done

if [[ ! $mode ]]; then
  usage >&2
  exit 2
fi

if ! repo_root=$(git rev-parse --show-toplevel || jj root --ignore-working-copy); then
  log "Current directory isn't in a git or jj repo"
  exit 1
fi

if ! [[ $repo_root -ef $PWD ]]; then
  log "Current directory isn't the repo root"
  exit 1
fi

repo_dirname=${repo_root##*/}
repo_name=${repo_dirname%%-*}

if [[ ! $profile ]]; then
  if [[ $mode == save && -f $edited_profile_path ]]; then
    profile=$(<"$edited_profile_path")
  else
    profile=$repo_name
  fi
fi

if ! [[ $profile =~ [:alnum:][[:alnum:]_-]* ]]; then
  log "Invalid profile name: ${profile@Q}"
  exit 1
fi

config_dir=$HOME/.config/agentwrap
patch_path=$config_dir/$profile.patch
edited_profile_path=$config_dir/.edited-profile

if [[ ! -e $config_dir ]]; then
  mkdir "$config_dir"
fi

case "$mode" in
  status)
    if [[ -f $edited_profile_path ]]; then
      cat "$edited_profile_path"
    else
      log "No profile is currently being edited"
      exit 1
    fi
    ;;
  edit)
    if [[ -f $patch_path ]]; then
      if ! git diff-index --quiet HEAD; then
        log "Refusing to apply patch for editing because the repo has uncommitted changes"
        exit 1
      fi
      if ! git apply --allow-empty "$patch_path"; then
        log "Failed to apply patch to the current repo"
        exit 1
      fi
      log "Applying patch for profile ${profile@Q} to the repo..."
    else
      log "No patch exists for profile ${profile@Q}; starting fresh"
    fi
    if ! printf >"$edited_profile_path" '%s\n' "$profile"; then
      log "Failed to record profile edit state."
      log "(You can still edit, but you might need --force to save. Be cautious.)"
      exit 1
    fi
    log "Profile patch applied. You may now make edits."
    log "- Use 'git diff' to see the current changes."
    log "- When finished, run '$script_basename save'."
    ;;
  save)
    if [[ -f $edited_profile_path ]]; then
      edited_profile=$(<"$edited_profile_path")
    fi
    if [[ $profile != "$edited_profile" && ! $force ]]; then
      log "Refusing to overwrite profile ${profile@Q} when the last-edited profile is ${edited_profile@Q}."
      log "Either 'edit' this profile first or use --force."
      exit 1
    fi
    if git diff --summary | grep '^ delete'; then
      log "Deletions aren't supported; replace with an empty file instead"
      exit 1
    fi
    if ! git diff >"$patch_path"; then
      log "Failed to save patch"
      exit 1
    fi
    log "Saved patch to profile ${profile@Q}"
    if ! rm "$edited_profile_path"; then
      log "Failed to clear $edited_profile_path"
      exit 1
    fi
    if ! git apply --reverse "$patch_path" --allow-empty; then
      log "Failed to undo the profile edits in the repo (undo them manually)"
      exit 1
    fi
    ;;
  run)
    if (( ${#run_args[@]} < 1 )); then
      run_args+=("${SHELL:-bash}")
    fi

    log "Running ${run_args[*]@Q} in profile ${profile@Q}"

    if ! tmpdir=$(mktemp -d --tmpdir "$script_basename.XXXX"); then
      log "Failed to create tempdir"
      exit 1
    fi
    if ! mkdir "$tmpdir"/agentwrap; then
      log "Failed to create agentwrap directory in tempdir"
      exit 1
    fi
    if ! pathlines=$(set -o pipefail; git apply --numstat "$patch_path" | awk '{ print $3 }' ); then
      log "Failed to parse patchfile"
      exit 1
    fi
    mapfile <<<"$pathlines" -t paths
    if ! cp -t "$tmpdir" --parents "${paths[@]}"; then
      log "Failed to copy modified paths into tempdir"
      exit 1
    fi
    if ! (cd "$tmpdir" && git apply "$patch_path"); then
      log "Failed to apply patchfile"
      exit 1
    fi

    if ! (
      mkdir "$tmpdir"/agentwrap/bin || exit 1
      cd "$tmpdir"/agentwrap/bin || exit 1
      printf >agentwrap-unwrap %s '#!/usr/bin/env bash
invoked_command_name=$(basename "$0")
repo_root='"${repo_root@Q}"'
tmpdir='"${tmpdir@Q}"'

old_ifs=$IFS
IFS=:
pathdirs=($PATH)
IFS=$old_ifs

# Remove the agentwrap bin dir from PATH
agentwrap_bin_dir=$(dirname "$0")
PATH=
for dir in "${pathdirs[@]}"; do
  if ! [[ $dir -ef $agentwrap_bin_dir ]]; then
    PATH=${PATH:+"$PATH:"}$dir
  fi
done

exec unshare --mount --map-current-user --keep-caps bash -c '"'"'
  repo_root=$1
  tmpdir=$2
  shift 2
  mount --bind "$tmpdir"/agentwrap/original-repo "$repo_root"
  cd "$PWD"
  exec setpriv --inh-caps=-all -- "$@"
'"'"' agentwrap-unwrap-inner "$repo_root" "$tmpdir" "$invoked_command_name" "$@"
' || exit 1
      chmod +x agentwrap-unwrap || exit 1
      ln -s agentwrap-unwrap git || exit 1
      ln -s agentwrap-unwrap jj || exit 1
    ); then
      log "Failed to set up unwrap scripts"
      exit 1
    fi

    exec unshare --mount --map-current-user --keep-caps bash -c '
      repo_root=$1
      tmpdir=$2
      shift 2

      mkdir "$tmpdir"/agentwrap/original-repo
      mount --bind "$repo_root" "$tmpdir"/agentwrap/original-repo

      if ! (
        cd "$tmpdir" && \
        find . -name agentwrap -prune -o -type f -exec mount -v --bind --make-private -o ro {} "$repo_root/{}" \;
      ); then
        echo >&2 "$0: Failed to set up bind mounts for patched files"
        exit 1
      fi

      PATH=$tmpdir/agentwrap/bin:$PATH exec setpriv --inh-caps=-all -- "$@"
    ' agentwrap-inner "$repo_root" "$tmpdir" "${run_args[@]}"
    ;;
esac
