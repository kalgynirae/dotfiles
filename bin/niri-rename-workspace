#!/usr/bin/env bash
current_name=$(niri msg --json workspaces | jq '.[]|select(.is_focused)|if .name then .name else "" end' -r)
if ! new_name=$(prompt 'Workspace Name' "$current_name"); then
  exit 0
fi
if [[ $new_name ]]; then
  niri msg action set-workspace-name "$new_name"
else
  niri msg action unset-workspace-name
fi
