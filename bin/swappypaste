#!/usr/bin/env python3
from subprocess import PIPE, CalledProcessError, run
from time import sleep


def read_clipboard():
    try:
        return run(["wl-paste", "--type=text", "--no-newline"], stdout=PIPE, check=True).stdout
    except CalledProcessError as e:
        if e.returncode == 1:
            return None
        else:
            raise


def write_clipboard(text):
    run(["wl-copy"], input=text, check=True)


def type_ctrl_c():
    run(["wtype", "-M", "ctrl", "-k", "c"], check=True)


def type_ctrl_v():
    run(["wtype", "-M", "ctrl", "-k", "v"], check=True)


def main():
    original_clipboard = read_clipboard()
    type_ctrl_c()
    sleep(0.2)
    new_clipboard = read_clipboard()
    write_clipboard(original_clipboard)
    type_ctrl_v()
    sleep(0.2)
    write_clipboard(new_clipboard)


if __name__ == "__main__":
    main()
