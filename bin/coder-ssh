#!/usr/bin/env bash
# usage: <SCRIPT> NAME [-t TEMPLATE]

usage() {
  awk <"$0" -v script="$0" '/$^/{exit}; NR==2,0{gsub(/<SCRIPT>/, script); print substr($0, 3)}'
}

name=
template=fusion

while (( $# )); do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    -t)
      if (( $# < 2 )); then
        echo >&2 "missing value for -t"
        exit 2
      fi
      template=$2
      shift 2
      ;;
    *)
      if [[ $name ]]; then
        echo >&2 "unrecognized argument: ${1@Q}"
        exit 2
      fi
      name=$1
      shift
      ;;
  esac
done

if [[ ! $name ]]; then
  usage >&2
  exit 1
fi

coder() {
  command coder --no-version-warning "$@"
}

args=(
  --template "$template"
  --use-parameter-defaults
)
if [[ $template == fusion ]]; then
  args+=(
    --parameter timezone="$(timedatectl show -p Timezone --value)"
    --parameter use_shpool=false
  )
fi

if ! coder list -a -o json | jq -e --arg name "$name" 'any(.name == $name)' >/dev/null; then
  echo >&2 "Creating new workspace..."
  if ! coder create "$name" -y "${args[@]}"; then
    echo >&2 "Failed to create workspace"
    exit 1
  fi
else
  echo >&2 "Connecting to existing workspace..."
fi

ssh-with-terminfo "main.$name.colin.coder"
